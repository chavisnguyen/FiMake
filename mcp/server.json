{
    "$schema": "https://static.modelcontextprotocol.io/schemas/2025-09-16/server.schema.json",
    "name": "io.github.chavisnguyen/fimake",
    "description": "Fimake MCP Server for Figma",
    "status": "active",
    "repository": {
        "url": "https://github.com/chavisnguyen/fimake.git",
        "source": "github"
    },
    "version": "1.0.32",
    "packages": [
        {
            "registryType": "npm",
            "registryBaseUrl": "https://registry.npmjs.org",
            "identifier": "@chavisnguyen/fimake",
            "version": "1.0.32",
            "transport": {
                "type": "stdio"
            },
            "environmentVariables": [
                {
                    "name": "TRANSPORT",
                    "required": false,
                    "isSecret": false,
                    "valueHint": "stdio"
                }
            ]
        },
        {
            "registryType": "npm",
            "registryBaseUrl": "https://registry.npmjs.org",
            "identifier": "@chavisnguyen/fimake",
            "version": "1.0.32",
            "transport": {
                "type": "streamable-http",
                "url": "http://localhost:10101/mcp"
            },
            "environmentVariables": [
                {
                    "name": "TRANSPORT",
                    "required": false,
                    "isSecret": false,
                    "valueHint": "streamable-http"
                }
            ]
        }
    ]
}
