# Copy to mcp/.env and adjust. See mcp/src/config/config.ts for all options.
# NOTE: code default is TRANSPORT=stdio. This example uses streamable-http
# because the README Usage (inspector / HTTP clients) needs the /mcp endpoint.
# The local mcp/.env (untracked, git-ignored) overrides these per machine.
TRANSPORT=streamable-http
# PORT for both the StreamableHTTP endpoint and the Socket.IO bridge the
# Figma plugin connects to. The plugin's manifest.json allowedDomains and
# ui.ts default URL hardcode 10101 — update them too if you change this.
PORT=10101
TASK_TIMEOUT_MS=20000
TASK_ACK_TIMEOUT_MS=5000
# CORS origin for Hono + Socket.IO ("*" = local dev only).
CORS_ORIGIN=*
JSON_BODY_LIMIT=1mb
# DEBUG=1: verbose wire logging (payloads, acks, sweeps). Task lifecycle
# (added/completed/failed/timed-out) always logs; plugin-side toggle is
# PLUGIN_DEBUG in plugin/main/debug.ts (Figma developer console).
