{
  "name": "fimake-plugin",
  "version": "1.0.40",
  "type": "module",
  "description": "Fimake plugin bridge for working with Figma documents via MCP",
  "scripts": {
    "test": "vitest run",
    "test:e2e": "playwright test",
    "lint": "eslint .",
    "test:full": "pnpm tsc && pnpm build && vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "tsc": "pnpm tsc:main && pnpm tsc:ui && pnpm tsc:tests",
    "tsc:main": "tsc --noEmit -p main",
    "tsc:ui": "tsc --noEmit -p ui",
    "tsc:tests": "tsc --noEmit -p tests",
    "tsc:watch": "concurrently -n main,ui \"pnpm tsc:main -- --watch --preserveWatchOutput\" \"pnpm tsc:ui -- --watch --preserveWatchOutput\"",
    "build": "pnpm build:ui && pnpm build:main",
    "prebuild": "rm -rf dist",
    "build:main": "node esbuild.config.mjs --minify",
    "build:ui": "vite build --minify esbuild",
    "build:watch": "concurrently -n main,ui \"pnpm build:main -- --watch\" \"pnpm build:ui -- --watch\"",
    "dev": "concurrently -n tsc,build 'pnpm:tsc:watch' 'pnpm:build:watch'"
  },
  "author": "chavisnguyen",
  "license": "Apache-2.0",
  "dependencies": {
    "@create-figma-plugin/utilities": "^4.0.3",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "socket.io-client": "^4.8.4",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@figma/plugin-typings": "^1.140.0",
    "@playwright/test": "^1.63.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^5.0.3",
    "concurrently": "^9.2.1",
    "esbuild": "^0.28.2",
    "eslint": "^10.12.0",
    "jsdom": "^30.1.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.0",
    "vite": "^8.3.2",
    "vite-plugin-singlefile": "^2.3.0",
    "vitest": "^5.0.3"
  },
  "packageManager": "pnpm@10.16.1+sha512.0e155aa2629db8672b49e8475da6226aa4bdea85fdcdfdc15350874946d4f3c91faaf64cbdc4a5d1ab8002f473d5c3fcedcd197989cf0390f9badd3c04678706"
}
